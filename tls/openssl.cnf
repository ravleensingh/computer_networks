# OpenSSL configuration for CN Project — TLS Certificate
# Mac2 — Edge / Reverse Proxy
#
# Usage:
#   openssl req -x509 -nodes -newkey rsa:2048 -sha256 \
#     -days 30 \
#     -keyout app.teamX.test.key \
#     -out app.teamX.test.crt \
#     -config openssl.cnf \
#     -extensions req_ext

[req]
distinguished_name = req_distinguished_name
req_extensions = req_ext
prompt = no

[req_distinguished_name]
C = IN
ST = Haryana
L = Sonipat
O = CN Project
CN = app.teamX.test

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = app.teamX.test
DNS.2 = api.teamX.test
